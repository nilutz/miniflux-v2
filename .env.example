# Copy this file to .env and fill in every value, then:
#
#   docker compose -f docker-compose.yaml up -d
#
# None of these variables have defaults in docker-compose.yaml -- a missing
# value makes `docker compose config` / `up` fail loudly rather than the
# stack quietly starting with a known-weak password.
#
# .env is git-ignored. Never commit it.

# --- PostgreSQL ---------------------------------------------------------
# Shared by the db, miniflux and sidecar services. Pick your own; nothing
# below is a working credential.
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=replace-with-a-generated-secret
POSTGRES_DB=miniflux

# --- Miniflux's first admin account -------------------------------------
# Created once, on first boot, by CREATE_ADMIN=1 in docker-compose.yaml.
# Changing these after the account already exists has no effect -- change
# the password from Miniflux's own settings page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-generated-secret

# --- Sidecar admin/status page -------------------------------------------
# The HOST port the sidecar's status/admin page and search API are
# published on -- pick any free port other than 8080 (Miniflux). Safe to
# publish: the sidecar authenticates every request with the same
# credentials Miniflux issues, and requires the signed-in user to be a
# Miniflux administrator.
SIDECAR_HOST_PORT=8091
