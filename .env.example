# Copy this file to .env and fill in every value, then:
#
#   docker compose -f docker-compose.yaml up -d
#
# None of these variables have defaults in docker-compose.yaml (task 16
# requirement 4) -- a missing value makes `docker compose config` / `up`
# fail loudly and immediately, rather than the stack quietly starting with
# a known-weak password. Every variable the production compose file
# references appears below; that correspondence is checked mechanically
# (grep, not by eye) as part of this task -- see the report.
#
# .env is git-ignored. Never commit it.

# --- PostgreSQL ---------------------------------------------------------
# Shared by the db, miniflux and sidecar services -- all three build their
# connection string from these three values, so they must be consistent
# with each other but do not need to match anything outside this stack.
# Pick your own; nothing below is a working credential.
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=replace-with-a-generated-secret
POSTGRES_DB=miniflux

# --- Miniflux's first admin account -------------------------------------
# Created once, on first boot, by CREATE_ADMIN=1 in docker-compose.yaml.
# Changing these after the account already exists has no effect -- change
# the password from Miniflux's own settings page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-generated-secret

# --- Sidecar admin/status page (task 18) --------------------------------
# The HOST port the sidecar's status/admin page and search API are
# published on -- pick any free port other than 8080 (Miniflux). It is
# safe to publish because the sidecar authenticates every request with
# the same credentials Miniflux itself issues: an X-Auth-Token API key,
# or (if you are already signed into Miniflux in this browser) the
# MinifluxSessionID session cookie -- no second login. The status page
# and every control endpoint (backfill pause/resume, the embedder
# switch) additionally require the signed-in user to be a Miniflux
# administrator. See SEARCH.md's "Running it in production" section.
SIDECAR_HOST_PORT=8091
